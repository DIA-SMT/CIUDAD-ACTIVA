# Copiá este archivo como .env.local y completá los valores del proyecto
# de Supabase (Project Settings > API). .env.local está en .gitignore:
# las claves nunca se suben al repositorio.

# URL del proyecto — ej: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Es pública por diseño: lo que protege
# los datos son las políticas RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role). SECRETA: saltea todas las políticas RLS.
# Sólo se usa en el servidor para dar de alta usuarios y resetear contraseñas.
# Nunca la pongas en una variable con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a la base, para correr las migraciones y la carga
# inicial desde la línea de comandos (Project Settings > Database > Connection
# string > URI). Incluye la contraseña: tratala como secreta.
DATABASE_URL=

# Contraseña inicial que se asigna a los usuarios de la carga inicial.
# El sistema les pide cambiarla la primera vez que entran.
PASSWORD_INICIAL=ciudadactiva2026

# Clave de la API de Claude, para el asistente del panel.
# Se saca de console.anthropic.com. Sin esto el panel funciona igual,
# pero la pestaña Asistente avisa que no esta configurado.
ANTHROPIC_API_KEY=
